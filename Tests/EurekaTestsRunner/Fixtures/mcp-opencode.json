{
  "$schema": "https://opencode.ai/config.json",
  "provider": { "anthropic": { "options": { "apiKey": "SECRET-PROVIDER-KEY" } } },
  "mcp": {
    "dataPro-search": {
      "type": "remote",
      "url": "https://mcp.datapro.example/search?plan=SECRET-PLAN",
      "headers": { "X-Agent-Plan-Key": "SECRET-HEADER" },
      "enabled": true
    },
    "local-runner": {
      "type": "local",
      "command": ["bun", "x", "my-mcp", "--fast"],
      "environment": { "RUNNER_TOKEN": "SECRET-ENV" },
      "enabled": false
    }
  }
}
